material {
    name : glow,
    shadingModel : unlit,
    requires : [position, uv0]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = getUV0();

       // 1. Convert UVs from [0, 1] to [-1, 1]
       vec2 centerUV = uv * 2.0 - 1.0;
       // 2. Calculate distance from the center (0,0)
       float dist = length(centerUV);

        // 3. Create a sharp or anti-aliased edge
        // smoothstep(edge0, edge1, x) creates a soft transition
        float alpha = 1.0 - smoothstep(0.95, 1.0, dist);

        // 4. Discard pixels outside the radius to save performance
        if (alpha <= 0.0) {
            discard;
        }

        // 5. Apply to your output (e.g., emissive for bloom)
        ///material.emissive = vec4(1.0, 1.0, 1.0, 1.0) * alpha;

        material.baseColor = vec4(225,0,0,1);
        material.emissive  = vec4(1.0f, 0.0f, 0.0f, 1);
        material.postLightingColor  = vec4(20.0f, 0.0f, 0.0f, 1);

   }

    
}